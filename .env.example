# --- Anthropic (le cerveau de l'agent) ---
ANTHROPIC_API_KEY=sk-ant-...
# Optionnel : modele utilise (par defaut claude-sonnet-4-6)
# Alternatives : claude-haiku-4-5-20251001 (moins cher), claude-opus-4-8 (qualite max)
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Google OAuth (Gmail + Agenda) ---
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxx

# --- Supabase (stockage) ---
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...  # cle service_role, JAMAIS exposee cote client

# --- Cron (securite) ---
# Genere une chaine aleatoire longue. Vercel l'enverra en Bearer token au cron.
CRON_SECRET=change-moi-pour-une-longue-chaine-aleatoire

# --- Reglages ---
TIMEZONE=Europe/Paris
# Optionnel : destinataire du briefing (par defaut = l'adresse Google connectee)
# BRIEFING_RECIPIENT=toi@gmail.com
